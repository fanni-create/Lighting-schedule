{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "build",
  "functions": {
    "api/convert-pdf.py": {
      "maxDuration": 60,
      "memory": 3008
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
