{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "build",
  "functions": {
    "api/convert-pdf.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    { "src": "/api/convert-pdf", "dest": "/api/convert-pdf.py" },
    { "src": "/api/sync", "dest": "/api/sync.py" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
